# ---------------------------------------------------------------- platform
# Deployment environment: dev, qa, uat or production (selects the integration_adapters rows).
APP_ENV=
# Directory for the SQLite database and encrypted object store (local/dev only).
ASR_DATA_DIR=
# Fernet key for field/object encryption at rest (HSM-backed key service in production; required there).
DATA_ENCRYPTION_KEY=
# Separate Fernet key for the Aadhaar Data Vault (HSM-backed; required in production).
AADHAAR_VAULT_KEY=
# Idle session timeout in seconds (default 300 = 5 minutes).
SESSION_IDLE_SECONDS=
# Set to true to refuse password-only sessions on customer and staff endpoints.
REQUIRE_MFA_SESSION=
# OTP accepted by MOCK SMS / authenticator adapters (never used once the live gateway is approved).
MOCK_OTP_CODE=
# Password given to the synthetic seed users (dev/qa/uat only).
SEED_PASSWORD=
# Show demo sign-in accounts on the login page outside production (true/false).
DEMO_MODE=
# Brand name printed on generated PDFs (placeholder until the bank confirms its brand).
BRAND_NAME=
# Backend base URL the browser uses (frontend build-time variable).
NEXT_PUBLIC_API_BASE=

# ---------------------------------------------------------------- Finacle core banking (via ESB, mTLS)
# Base URL of the bank's ESB endpoint for Finacle services.
FINACLE_ESB_BASE_URL=
# Client certificate for mTLS to the ESB.
FINACLE_MTLS_CERT_PATH=
# Private key for the mTLS client certificate.
FINACLE_MTLS_KEY_PATH=

# ---------------------------------------------------------------- UIDAI (Aadhaar OTP eKYC)
# AUA code issued by UIDAI to the bank.
UIDAI_AUA_CODE=
# URL of the ASA (authentication service agency) the bank connects through.
UIDAI_ASA_URL=
# AUA licence key.
UIDAI_LICENSE_KEY=

# ---------------------------------------------------------------- NSDL / Protean PAN verification
# PAN verification API URL.
PAN_VERIFY_URL=
# User ID registered with NSDL/Protean.
PAN_VERIFY_USER_ID=
# Signing certificate used for PAN verification requests.
PAN_VERIFY_SIGNING_CERT_PATH=

# ---------------------------------------------------------------- DigiLocker
# DigiLocker partner client ID.
DIGILOCKER_CLIENT_ID=
# DigiLocker partner client secret.
DIGILOCKER_CLIENT_SECRET=
# Redirect URI registered with DigiLocker.
DIGILOCKER_REDIRECT_URI=

# ---------------------------------------------------------------- CKYC Registry (CERSAI)
# FI code issued by CERSAI.
CKYCR_FI_CODE=
# CKYCR API URL.
CKYCR_API_URL=
# Signing certificate for CKYCR requests.
CKYCR_SIGNING_CERT_PATH=

# ---------------------------------------------------------------- NPCI UPI
# NPCI UPI switch URL.
NPCI_UPI_SWITCH_URL=
# PSP code of the bank.
NPCI_UPI_PSP_CODE=
# Signing key for UPI messages.
NPCI_UPI_SIGNING_KEY_PATH=

# ---------------------------------------------------------------- NPCI IMPS
# NPCI IMPS switch URL.
NPCI_IMPS_SWITCH_URL=
# IMPS bank code (NBIN).
NPCI_IMPS_BANK_CODE=

# ---------------------------------------------------------------- NPCI NACH / e-NACH
# NACH/e-NACH API URL.
NPCI_NACH_URL=
# NACH utility code of the bank.
NPCI_NACH_UTILITY_CODE=

# ---------------------------------------------------------------- Bharat Connect (BBPS)
# BBPS BOU (Bharat Bill Payment Operating Unit) URL.
BBPS_BOU_URL=
# Agent institution ID.
BBPS_AGENT_INSTITUTION_ID=

# ---------------------------------------------------------------- NEFT / RTGS (SFMS)
# SFMS gateway URL.
SFMS_GATEWAY_URL=
# IFSC prefix of the bank used in SFMS messages.
SFMS_IFSC_PREFIX=

# ---------------------------------------------------------------- Credit bureau
# Bureau API URL.
BUREAU_API_URL=
# Bureau member ID.
BUREAU_MEMBER_ID=
# Bureau API key.
BUREAU_API_KEY=

# ---------------------------------------------------------------- Account Aggregator (FIU)
# FIU ID registered with the AA ecosystem.
AA_FIU_ID=
# AA gateway URL.
AA_GATEWAY_URL=
# Signing key for AA requests.
AA_SIGNING_KEY_PATH=

# ---------------------------------------------------------------- GSTN (via GSP)
# GSP API URL.
GSP_API_URL=
# GSP client ID.
GSP_CLIENT_ID=
# GSP client secret.
GSP_CLIENT_SECRET=

# ---------------------------------------------------------------- Income-tax ITR fetch
# ITR data API URL.
ITR_API_URL=
# ITR data API key.
ITR_API_KEY=

# ---------------------------------------------------------------- Aadhaar eSign (ESP)
# eSign service provider URL.
ESIGN_ESP_URL=
# ASP ID of the bank.
ESIGN_ASP_ID=
# Signing certificate for eSign requests.
ESIGN_SIGNING_CERT_PATH=

# ---------------------------------------------------------------- SHCIL (e-stamping)
# SHCIL API URL.
SHCIL_API_URL=
# SHCIL client ID.
SHCIL_CLIENT_ID=

# ---------------------------------------------------------------- Card management system
# Card management system API URL.
CMS_API_URL=
# Client certificate for the card management system.
CMS_CLIENT_CERT_PATH=

# ---------------------------------------------------------------- HSM
# HSM endpoint.
HSM_ENDPOINT=
# HSM partition name.
HSM_PARTITION=
# Client certificate for the HSM.
HSM_CLIENT_CERT_PATH=

# ---------------------------------------------------------------- SWIFT (gpi)
# SWIFT Alliance gateway URL.
SWIFT_ALLIANCE_URL=
# BIC of the bank.
SWIFT_BIC=

# ---------------------------------------------------------------- CRM
# CRM lead API URL.
CRM_API_URL=
# CRM API key.
CRM_API_KEY=

# ---------------------------------------------------------------- SMS / email / push gateway
# SMS gateway URL.
SMS_GATEWAY_URL=
# SMS gateway API key.
SMS_GATEWAY_API_KEY=
# DLT-registered SMS sender ID.
SMS_SENDER_ID=
# SMTP URL for email alerts.
EMAIL_SMTP_URL=

# ---------------------------------------------------------------- Mutual fund RTA / exchange
# RTA / exchange API URL.
MF_RTA_API_URL=
# ARN of the bank as distributor.
MF_RTA_ARN=
# RTA API key.
MF_RTA_API_KEY=

# ---------------------------------------------------------------- GST / income-tax challan portals
# Tax portal API URL (CIN generation).
TAX_PORTAL_API_URL=
# Bank code registered with the tax portals.
TAX_PORTAL_BANK_CODE=
