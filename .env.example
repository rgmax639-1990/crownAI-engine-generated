# Stripe secret API key used to create live checkout sessions (server-side only)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret used to verify incoming payment webhook events
STRIPE_WEBHOOK_SECRET=

# Google Maps Platform API key used to render the Chennai office location map on the Contact page
GOOGLE_MAPS_API_KEY=

# OAuth client ID issued by Google Cloud Console for "Sign in with Google"
GOOGLE_CLIENT_ID=

# OAuth client secret issued by Google Cloud Console for "Sign in with Google"
GOOGLE_CLIENT_SECRET=

# OAuth redirect URI registered with Google (must exactly match the backend callback URL)
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# OAuth client ID issued by a Microsoft Entra ID (Azure AD) app registration for "Sign in with Microsoft"
MICROSOFT_CLIENT_ID=

# OAuth client secret issued by the Microsoft Entra ID app registration
MICROSOFT_CLIENT_SECRET=

# Microsoft Entra ID tenant ID ("common" allows personal + work/school accounts)
MICROSOFT_TENANT_ID=common

# OAuth redirect URI registered with Microsoft (must exactly match the backend callback URL)
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# Dev-only mock sign-in for providers without OAuth credentials; set to false in production (and for tests that verify the real Google/Microsoft redirect)
OAUTH_DEV_MOCK=true

# Secret key used to sign backend-issued JWT session tokens - set a long random value in production
JWT_SECRET_KEY=

# Public base URL of the frontend app, used for post-login and post-checkout redirects
FRONTEND_URL=http://localhost:3000

# Base URL the frontend uses to reach the backend API (exposed to the browser; use 127.0.0.1, not localhost, to avoid IPv6 resolution misses)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# Optional server-side-only backend URL for Next.js server rendering (e.g. http://backend:8000 inside docker-compose); falls back to NEXT_PUBLIC_API_BASE
API_BASE_INTERNAL=
